{
  "version": 11,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 3,
    "patch": 6
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "macos-arm64-release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "14.4"
      }
    },
    {
      "name": "windows-x64-release",
      "inherits": "base"
    },
    {
      "name": "linux-x64-release",
      "inherits": "base"
    },
    {
      "name": "relwithdebinfo",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    }
  ],
  "buildPresets": [
    { "name": "macos-arm64-release", "configurePreset": "macos-arm64-release" },
    { "name": "windows-x64-release", "configurePreset": "windows-x64-release" },
    { "name": "linux-x64-release", "configurePreset": "linux-x64-release" },
    { "name": "relwithdebinfo", "configurePreset": "relwithdebinfo" }
  ]
}
